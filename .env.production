# Firebase web config — committed on purpose.
#
# These NEXT_PUBLIC_* values are shipped to the browser in every build, so they
# are not secrets. Committing them here lets Vercel (and any other host) build
# straight from git with no dashboard setup — edit, commit, push, done.
#
# Real security for this project comes from Firestore/Storage security rules and
# the Firebase Auth "Authorized domains" list, not from hiding these values.
#
# Local development overrides these via .env.local (which stays uncommitted).

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBAp6YXum_t3UpIjON9zB4Ah9ZRU22JiRM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=claude---dashboard-2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=claude---dashboard-2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=claude---dashboard-2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=107302164405
NEXT_PUBLIC_FIREBASE_APP_ID=1:107302164405:web:74627a8785a8e3dbbfebfc
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-671REW0466
