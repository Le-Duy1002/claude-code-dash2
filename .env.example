# Firebase web config (public — NEXT_PUBLIC_*). Real values are in .env.production.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Google Drive document sync (server only) ---

# Firebase Admin service account:
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n (keep the surrounding quotes)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive access. By default the Firebase Admin service account above is
# reused — just enable the Google Drive API on that GCP project and share the
# team folder with FIREBASE_ADMIN_CLIENT_EMAIL (Viewer). Override here only to
# use a different service account.
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=

# The shared library folder's id. It must be a folder CREATED BY THE OAUTH APP
# (run scripts/create-drive-folder.mjs once) — the drive.file scope cannot write
# into a pre-existing folder. Then share that folder with the service account.
GOOGLE_DRIVE_FOLDER_ID=
# Optional: full folder URL, shown as an "Open Drive folder" link in the UI
NEXT_PUBLIC_DRIVE_FOLDER_URL=

# Shared secret for the cron triggers (GitHub Actions / Vercel Cron). Any random
# string. Used by /api/drive/sync AND /api/pancake/sync.
CRON_SECRET=

# --- Pancake work-tracking ("Theo dõi công việc") ---
# POS: one api_key per shop (identifies the shop). INBOX: one account
# access_token covering every page (base https://pages.fm/api/v1). All read-only.
PANCAKE_PRODUCT=pos,inbox
PANCAKE_POS_API_BASE=https://pos.pages.fm/api/v1
PANCAKE_POS_1_NAME=
PANCAKE_POS_1_API_KEY=
PANCAKE_POS_1_SHOP_ID=
PANCAKE_POS_1_FB_PAGE_ID=
# PANCAKE_POS_2_* … up to _3_*
PANCAKE_INBOX_API_BASE=https://pages.fm/api/v1
PANCAKE_INBOX_ACCESS_TOKEN=
# Cron -> POST /api/pancake/sync writes pancakeAgentDaily/{date} (Admin SDK).
# The dashboard reads those docs; add a client read-only Firestore rule for
# `pancakeAgentDaily` (allow write: if false) in the Firebase console.

# --- Google Drive writes (web -> Drive upload / rename / delete) ---
# OAuth client (Web application) from Google Cloud Console -> Credentials, with
# redirect URI http://localhost:5555/callback and the drive.file scope. Then run
#   node --env-file=.env.local scripts/get-refresh-token.mjs
# signing in as the Drive folder owner, and paste the printed refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Google Drive: folder-per-project (feature "Dự án") ---
# A SECOND OAuth identity (same OAuth client, different Google account) that
# owns the "Dự án" parent folder. drive.file cannot write into a folder made by
# hand, so this account must create the folder via scripts/create-projects-folder.mjs.
#   1. node --env-file=.env.local scripts/get-refresh-token.mjs GOOGLE_OAUTH_PROJECTS_REFRESH_TOKEN
#      (sign in as the account that should own the Dự án folder)
#   2. node --env-file=.env.local scripts/create-projects-folder.mjs
#   3. share the printed folder with FIREBASE_ADMIN_CLIENT_EMAIL (Viewer)
# CLIENT_ID / _SECRET fall back to GOOGLE_OAUTH_* if unset.
# GOOGLE_OAUTH_PROJECTS_CLIENT_ID=
# GOOGLE_OAUTH_PROJECTS_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECTS_REFRESH_TOKEN=
GOOGLE_DRIVE_PROJECTS_FOLDER_ID=
